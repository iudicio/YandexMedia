<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_menu"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="32dp">

    <View
        android:layout_width="50dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@color/color_gray_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/playlistMenuCoverImage"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:contentDescription="@string/content_album_art"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playlistMenuNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/ys_display_regular"
                android:maxLines="1"
                android:textColor="@color/black"
                android:textSize="16sp"
                tools:text="Best songs 2021" />

            <TextView
                android:id="@+id/playlistMenuTracksCountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/ys_display_regular"
                android:textColor="@color/color_gray_dark"
                android:textSize="12sp"
                tools:text="98 треков" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/menuShare"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:fontFamily="@font/ys_display_regular"
        android:gravity="center_vertical"
        android:text="Поделиться"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/menuEdit"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:fontFamily="@font/ys_display_regular"
        android:gravity="center_vertical"
        android:text="Редактировать информацию"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/menuDelete"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:fontFamily="@font/ys_display_regular"
        android:gravity="center_vertical"
        android:text="Удалить плейлист"
        android:textColor="@color/black"
        android:textSize="16sp" />

</LinearLayout>