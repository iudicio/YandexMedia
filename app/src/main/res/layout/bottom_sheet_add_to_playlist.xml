<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="440dp"
    android:background="@color/color_navbar"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <View
        android:layout_width="50dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/color_playlist" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/ys_display_medium"
        android:text="Добавить в плейлист"
        android:textColor="@color/color_black"
        android:textSize="20sp" />

    <ImageButton
        android:id="@+id/newPlaylistButton"
        android:layout_width="300dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@color/color_navbar"
        android:contentDescription="@string/new_playlist"
        android:scaleType="center"
        android:src="@drawable/new_playlist" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playlistsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:background="@color/color_navbar"
        android:layout_weight="1" />

</LinearLayout>